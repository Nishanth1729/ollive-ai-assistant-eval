# API keys
GROQ_API_KEY=your_groq_api_key_here
HF_API_TOKEN=your_huggingface_token_her

# OSS model config
# Optional HuggingFace Spaces endpoint for the Qwen assistant.
HF_SPACE_URL=https://your-space-url.hf.space
# Or use the HuggingFace Inference API directly.
HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Frontier model config
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024

# Observability (optional Langfuse tracing)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Evaluation
EVAL_JUDGE_MODEL=llama-3.3-70b-versatile
EVAL_OUTPUT_DIR=data/results
